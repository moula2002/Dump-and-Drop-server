# Database Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/dump_and_drop

# JWT Settings
JWT_SECRET=your_jwt_secret_key_here

# Firebase Admin SDK Configuration
# To get this JSON:
# 1. Go to Firebase Console -> Project Settings -> Service Accounts
# 2. Click "Generate new private key"
# 3. Minify/stringify the downloaded JSON file and paste it here:
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "dump-and-drop-2679c", ...}

# AWS S3 Settings (if applicable)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
